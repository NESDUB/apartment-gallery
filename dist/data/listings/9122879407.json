er Haven. NEW HOME. BEAUTIFUL COMMUNITY. FANTASTIC AMENITIES. EXCELLENT CONVENIENCE! Don't miss this opportunity to enjoy modern townhome living in one of Lake Wales' exciting new communities. Schedule your private showing today and make 391 Sequoia Drive your next home!","age_restricted":false,"income_restricted":false,"flags":[],"min_rent":1995,"images":[{"url":"https://ap.rdcpix.com/4d8497dd542e342c3d9d6f01f9360a7el-m3664011909r.jpg","title":null,"tags":["door","garage","house_view","porch","front","incomplete","exterior"],"primary":true,"origins":[{"kind":"primary"},{"kind":"listing"},{"kind":"api_gallery"}],"source_urls":["https://ap.rdcpix.com/4d8497dd542e342c3d9d6f01f9360a7el-m3664011909s.jpg","https://ap.rdcpix.com/4d8497dd542e342c3d9d6f01f9360a7el-m3664011909r.jpg"],"resolution_source":"API size:MAX"},{"url":"https://ap.rdcpix.com/4d8497dd542e342c3d9d6f01f9360a7el-m2030732763r.jpg","title":null,"tags":["door","garage","house_view","porch","front","incomplete","exterior"],"primary":false,"origins":[{"kind":"listing"},{"kind":"api_gallery"}],"source_urls":["https://ap.rdcpix.com/4d8497dd542e342c3d9d6f01f9360a7el-m2030732763s.jpg","https://ap.rdcpix.com/4d8497dd542e342c3d9d6f01f9360a7el-m2030732763r.jpg"],"resolution_source":"API size:MAX"},{"url":"https://ap.rdcpix.com/4d8497dd542e342c3d9d6f01f9360a7el-m943396508r.jpg","title":null,"tags":["corridor","unknown"],"primary":false,"origins":[{"kind":"listing"},{"kind":"api_gallery"}],"source_urls":["https://ap.rdcpix.com/4d8497dd542e342c3d9d6f01f9360a7el-m943396508s.jpg","https://ap.rdcpix.com/4d8497dd542e342c3d9d6f01f9360a7el-m943396508r.jpg"],"resolution_source":"API size:MAX"},{"url":"https://ap.rdcpix.com/4d8497dd542e342c3d9d6f01f9360a7el-m4163281362r.jpg","title":null,"tags":["other_interiors","unknown"],"primary":false,"origins":[{"kind":"listing"},{"kind":"listing"},{"kind":"api_gallery"},{"kind":"api_gallery"}],"source_urls":["https://ap.rdcpix.com/4d8497dd542e342c3d9d6f01f9360a7el-m4163281362s.jpg","http